# Copia este archivo como ".env" y llena los valores (NUNCA subas .env a GitHub)

# Conexión a MongoDB Atlas
MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster.xxxxx.mongodb.net/dropsystem

# Clave de la API de xAI (Grok)
API_KEY=

# Secreto para firmar las sesiones: una frase larga y aleatoria (mínimo 32 caracteres)
JWT_SECRET=

# Usuario administrador inicial (solo se usa la primera vez, cuando no hay usuarios)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# En Render pon "production" (activa cookies seguras por HTTPS)
NODE_ENV=production

# Opcional: máximo de consultas de IA por minuto por usuario (por defecto 20)
# IA_MAX_POR_MINUTO=20
